{
  "name": "obsidian-publish-to-telegram",
  "version": "6.2.3",
  "description": "Post notes directly to Telegram channels, groups and personal messages with different presets and advanced publishing settings.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=cjs --outdir=tests/.tmp --out-extension:.js=.cjs && node --test tests/.tmp/convert.test.cjs tests/.tmp/util.test.cjs tests/.tmp/split.test.cjs tests/.tmp/emoji.test.cjs",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:ts": "eslint .",
    "lint:css": "stylelint \"**/*.css\" --ignore-disables",
    "lint:fix": "eslint --fix . && stylelint \"**/*.css\" --fix"
  },
  "keywords": [],
  "author": "pan4ratte",
  "license": "AGPL-3.0",
  "type": "commonjs",
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.13.1",
    "stylelint": "^17.15.0",
    "stylelint-config-obsidianmd": "^0.1.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.60.1"
  },
  "dependencies": {
    "@mtcute/html-parser": "^0.32.3",
    "@mtcute/wasm": "^0.32.0",
    "@mtcute/web": "^0.32.3",
    "@types/qrcode": "^1.5.6",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "constants-browserify": "^1.0.0",
    "events": "^3.3.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "qrcode": "^1.5.4",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2"
  }
}
